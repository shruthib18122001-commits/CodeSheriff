{
  "name": "codesheriff",
  "displayName": "CodeSheriff",
  "description": "Ask natural language questions about your codebase, right from VS Code.",
  "version": "0.1.0",
  "publisher": "codesheriff",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codesheriff",
          "title": "CodeSheriff",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "codesheriff": [
        {
          "id": "codesheriffRepos",
          "name": "Repos"
        }
      ]
    },
    "commands": [
      {
        "command": "codesheriff.askSelection",
        "title": "Ask CodeSheriff"
      },
      {
        "command": "codesheriff.refreshRepos",
        "title": "CodeSheriff: Refresh Repos",
        "icon": "$(refresh)"
      },
      {
        "command": "codesheriff.selectRepo",
        "title": "CodeSheriff: Set as Active Repo"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codesheriff.askSelection",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ],
      "view/title": [
        {
          "command": "codesheriff.refreshRepos",
          "when": "view == codesheriffRepos",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "codesheriff.selectRepo",
          "when": "view == codesheriffRepos"
        }
      ]
    },
    "configuration": {
      "title": "CodeSheriff",
      "properties": {
        "codesheriff.apiBaseUrl": {
          "type": "string",
          "default": "http://localhost:8000/api",
          "description": "Base URL of the CodeSheriff API."
        },
        "codesheriff.token": {
          "type": "string",
          "default": "",
          "description": "JWT issued after signing in to CodeSheriff. Copy the 'cs_token' value from the web app's localStorage after logging in."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.6.2"
  },
  "dependencies": {
    "axios": "^1.7.7"
  }
}
